{
    "version": "0.2.0",
    "projectName": "nucleo-f103rb",
    "configurations": [
        {
            "name": "STlink launch",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "/workspace/m3dev/Debug/Template.elf",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "gdbPath": "/usr/bin/gdb-multiarch",
            "device": "STM32F103RB",
            "armToolchainPath": "/opt/arm-toolchain/bin/",
            "breakAfterReset": true,
            "preLaunchTask": "Rebuild with Make",
        },
    ]
}
